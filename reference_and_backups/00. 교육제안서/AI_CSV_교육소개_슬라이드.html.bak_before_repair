<!DOCTYPE html>
<html lang="ko" class="theme-light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>국내최초 AI 활용 데이터 완전성 솔루션 구축 및 밸리데이션 실습 과정</title>
  <link rel="icon" type="image/png" href="data:image/png;base64,">
  <link rel="shortcut icon" type="image/png" href="data:image/png;base64,">
  <link rel="apple-touch-icon" href="data:image/png;base64,">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { interpolate-size: allow-keywords; }

    /* ===== THEMES (class-based, Toss-inspired clean palette) ===== */
    html.theme-light {
      --bg: #FFFFFF;
      --surface: #F9FAFB;
      --surface-hover: #F2F4F6;
      --border: #E5E8EB;
      --text: #191F28;
      --text-secondary: #4E5968;
      --text-tertiary: #8B95A1;
      --accent: #3182F6;
      --accent-secondary: #1B64DA;
      --accent-soft: #E8F3FF;
      --positive: #00C896;
      --negative: #F04452;
      --warning: #FF9500;
    }
    html.theme-dark {
      --bg: #0A0A0A;
      --surface: #141414;
      --surface-hover: #1C1C1C;
      --border: rgba(255,255,255,0.06);
      --text: #EDEDED;
      --text-secondary: #B0B8C1;
      --text-tertiary: #6B7684;
      --accent: #4592FF;
      --accent-secondary: #3182F6;
      --accent-soft: rgba(69,146,255,0.12);
      --positive: #00D4A0;
      --negative: #FF6B7A;
      --warning: #FFB340;
    }

    body {
      font-family: 'Pretendard', 'Noto Sans KR', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      letter-spacing: -0.02em;
      -webkit-font-smoothing: antialiased;
      transition: background 0.3s, color 0.3s;
      scrollbar-gutter: stable;
      overflow-x: hidden;
    }
    h1, h2, h3, h4, h5, h6 {
      color: var(--text);
      letter-spacing: -0.04em;
      line-height: 1.15;
      text-wrap: balance;
      font-family: 'Pretendard', 'Noto Sans KR', 'Inter', sans-serif;
    }
    h1 { font-weight: 800; font-size: 3.5rem; }
    h2 { font-weight: 700; font-size: 2.5rem; }
    h3 { font-weight: 600; font-size: 1.5rem; }
    p, li, td, th, span, label { color: var(--text); font-weight: 400; }
    .text-secondary { color: var(--text-secondary); }
    .text-tertiary { color: var(--text-tertiary); }

    @media (max-width: 768px) {
      h1 { font-size: 2.25rem; }
      h2 { font-size: 1.75rem; }
      h3 { font-size: 1.25rem; }
    }
    @media (max-width: 375px) {
      body { overflow-x: hidden; }
    }

    /* ===== CARD ===== */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px;
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .card:hover {
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
      border-color: var(--text-tertiary);
    }

    /* ===== ANIMATIONS ===== */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideInLeft {
      from { opacity: 0; transform: translateX(-40px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes slideInRight {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .animate { animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .animate.delay-1 { animation-delay: 0.08s; }
    .animate.delay-2 { animation-delay: 0.16s; }
    .animate.delay-3 { animation-delay: 0.24s; }
    .animate.delay-4 { animation-delay: 0.32s; }
    .animate.delay-5 { animation-delay: 0.40s; }
    .animate.delay-6 { animation-delay: 0.48s; }

    .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
      .reveal { opacity: 1; transform: none; }
    }

    /* ===== PRINT ===== */
    @media print {
      body { background: white !important; color: black !important; }
      .viz-menu, .slide-nav, .progress-bar { display: none !important; }
      .reveal { opacity: 1 !important; transform: none !important; }
      .slide { display: block !important; page-break-after: always; min-height: auto; height: auto; padding: 40px; }
      .card { break-inside: avoid; border: 1px solid #ddd; box-shadow: none; }
      * { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    }
    @page { margin: 0.5in; @bottom-center { content: counter(page) " / " counter(pages); font-size: 9pt; color: #888; } }

    /* ===== MENU ===== */
    .viz-menu { position: fixed; top: 20px; right: 20px; z-index: 9999; }
    .viz-menu-toggle {
      width: 44px; height: 44px; border-radius: 12px;
      background: var(--surface); border: 1px solid var(--border);
      color: var(--text); cursor: pointer; display: flex;
      align-items: center; justify-content: center;
      backdrop-filter: blur(12px); transition: all 0.2s;
    }
    .viz-menu-toggle:hover { background: var(--surface-hover); }
    .viz-menu-dropdown {
      position: absolute; top: 52px; right: 0; min-width: 200px;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 12px; padding: 8px;
      opacity: 0; visibility: hidden; transform: translateY(-8px);
      transition: all 0.2s; backdrop-filter: blur(16px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }
    .viz-menu-dropdown.open { opacity: 1; visibility: visible; transform: translateY(0); }
    .viz-menu-dropdown button {
      width: 100%; padding: 10px 14px; border: none; border-radius: 8px;
      background: transparent; color: var(--text); font-size: 14px;
      font-family: inherit; cursor: pointer; text-align: left;
      display: flex; align-items: center; gap: 10px; transition: background 0.15s;
    }
    .viz-menu-dropdown button:hover { background: var(--surface-hover); }

    /* ===== SKIP TO CONTENT ===== */
    .skip-to-content {
      position: absolute; top: -40px; left: 6px; background: var(--accent);
      color: white; padding: 8px 12px; text-decoration: none;
      border-radius: 4px; opacity: 0; pointer-events: none;
      transition: all 0.2s; z-index: 10000;
    }
    .skip-to-content:focus { top: 6px; opacity: 1; pointer-events: auto; }

    /* ===== SLIDE DECK SYSTEM ===== */
    .slide-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }

    .slide {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 100%;
      padding: clamp(48px, 5.5vw, 120px) clamp(56px, 6.67vw, 160px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transform: translateX(40px);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.5s;
    }
    .slide.active {
      opacity: 1;
      visibility: visible;
      transform: translateX(0);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0s;
    }
    .slide.prev {
      transform: translateX(-40px);
    }

    @media (max-width: 768px) {
      .slide { padding: 56px 32px; }
    }
    @media (max-width: 375px) {
      .slide { padding: 48px 24px; }
    }

    /* Progress bar */
    .progress-bar {
      position: fixed;
      top: 0; left: 0;
      height: 3px;
      background: var(--accent);
      z-index: 9998;
      transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Slide navigation */
    .slide-nav {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 9998;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 6px 8px;
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }
    .slide-nav button {
      width: 36px; height: 36px;
      border-radius: 999px;
      background: transparent;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .slide-nav button:hover {
      background: var(--surface-hover);
      color: var(--text);
    }
    .slide-counter {
      font-size: 13px;
      color: var(--text-secondary);
      font-weight: 500;
      min-width: 48px;
      text-align: center;
      font-feature-settings: 'tnum';
    }

    /* ===== TOSS-STYLE COMPONENTS ===== */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: var(--accent-soft);
      color: var(--accent);
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: -0.01em;
      margin-bottom: 24px;
    }
    .badge-dot {
      width: 6px; height: 6px;
      border-radius: 999px;
      background: var(--accent);
    }

    .eyebrow {
      font-size: clamp(1rem, 1.4vw, 1.75rem);
      font-weight: 700;
      color: var(--accent);
      text-transform: none;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
      display: inline-block;
    }
    @media (max-width: 768px) {
      .eyebrow { font-size: 1rem; margin-bottom: 14px; }
    }

    .hero-title {
      font-size: clamp(2.5rem, 6vw, 8rem);
      font-weight: 800;
      letter-spacing: -0.045em;
      line-height: 1.08;
      margin-bottom: 32px;
      max-width: 1600px;
    }
    .hero-subtitle {
      font-size: clamp(1.125rem, 2vw, 2.25rem);
      color: var(--text-secondary);
      font-weight: 400;
      line-height: 1.55;
      max-width: 1200px;
      margin-bottom: 56px;
    }

    .accent-text { color: var(--accent); }
    .text-strong { color: var(--text); font-weight: 700; }

    /* Big number stat */
    .stat-block {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .stat-value {
      font-size: clamp(3.5rem, 8vw, 10rem);
      font-weight: 800;
      letter-spacing: -0.05em;
      line-height: 1;
      color: var(--text);
      font-feature-settings: 'tnum';
    }
    .stat-value.accent { color: var(--accent); }
    .stat-label {
      font-size: clamp(0.875rem, 1.1vw, 1.4rem);
      color: var(--text-secondary);
      font-weight: 500;
    }

    /* Quote slide */
    .quote-large {
      font-size: clamp(1.75rem, 3.5vw, 4.5rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.3;
      max-width: 1500px;
      color: var(--text);
    }
    .quote-large .highlight {
      color: var(--accent);
    }

    /* Grid layouts */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    @media (max-width: 900px) {
      .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
    }

    /* Feature card (Toss style — clean, generous, hover lifts) */
    .feature-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 36px;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      gap: 16px;
      height: 100%;
    }
    .feature-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.08);
      border-color: var(--accent);
    }
    .feature-icon {
      width: 56px; height: 56px;
      border-radius: 16px;
      background: var(--accent-soft);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .feature-number {
      font-size: 14px;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: -0.01em;
      margin-bottom: -4px;
    }
    .feature-title {
      font-size: 1.375rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.3;
    }
    .feature-desc {
      font-size: 0.95rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    /* Info row (key-value) */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
      border-top: 1px solid var(--border);
    }
    .info-row {
      display: flex;
      align-items: baseline;
      padding: 20px 0;
      border-bottom: 1px solid var(--border);
      gap: 24px;
    }
    .info-label {
      font-size: 0.9rem;
      color: var(--text-secondary);
      font-weight: 500;
      flex-shrink: 0;
      min-width: 110px;
    }
    .info-value {
      font-size: 1.05rem;
      color: var(--text);
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    @media (max-width: 768px) {
      .info-grid { grid-template-columns: 1fr; }
    }

    /* Compare blocks */
    .compare-block {
      background: var(--surface);
      border-radius: 20px;
      padding: 36px;
      border: 1px solid var(--border);
    }
    .compare-block.highlight {
      background: var(--accent-soft);
      border-color: var(--accent);
    }
    .compare-block.highlight .compare-label {
      color: var(--accent);
    }
    .compare-label {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--text-secondary);
      letter-spacing: -0.02em;
      margin-bottom: 18px;
    }
    .compare-content {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.025em;
      line-height: 1.45;
      color: var(--text);
    }
    @media (max-width: 768px) {
      .compare-label { font-size: 1rem; }
      .compare-content { font-size: 1.05rem; }
    }

    /* Day timeline */
    .day-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px;
      transition: all 0.2s ease;
    }
    .day-card:hover {
      border-color: var(--accent);
    }
    .day-header {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }
    .day-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .day-title {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.025em;
    }
    .schedule-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .schedule-item {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }
    .schedule-item:last-child { border-bottom: none; }
    .schedule-time {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-secondary);
      font-feature-settings: 'tnum';
      min-width: 100px;
      flex-shrink: 0;
      padding-top: 2px;
    }
    .schedule-content {
      flex: 1;
    }
    .schedule-tag {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0;
      margin-right: 8px;
      vertical-align: middle;
    }
    .schedule-tag.theory {
      background: var(--accent-soft);
      color: var(--accent);
    }
    .schedule-tag.practice {
      background: rgba(0, 200, 150, 0.12);
      color: var(--positive);
    }
    .schedule-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1.4;
      letter-spacing: -0.02em;
      display: inline;
    }

    /* Outcome list */
    .outcome-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .outcome-item {
      display: flex;
      align-items: flex-start;
      gap: 24px;
      padding: 28px 0;
      border-bottom: 1px solid var(--border);
    }
    .outcome-item:last-child { border-bottom: none; }
    .outcome-num {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--accent);
      font-feature-settings: 'tnum';
      letter-spacing: -0.02em;
      min-width: 36px;
      flex-shrink: 0;
    }
    .outcome-text {
      font-size: 1.125rem;
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.55;
      color: var(--text);
    }
    .outcome-text strong {
      font-weight: 700;
      color: var(--text);
    }

    /* Big stat grid (KPI) */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
      padding: 40px 0;
    }
    @media (max-width: 900px) {
      .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .kpi {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .kpi-value {
      font-size: clamp(2.5rem, 5vw, 7rem);
      font-weight: 800;
      letter-spacing: -0.05em;
      line-height: 1;
      color: var(--text);
      font-feature-settings: 'tnum';
    }
    .kpi-value .small {
      font-size: 0.5em;
      color: var(--text-secondary);
      font-weight: 600;
    }
    .kpi-label {
      font-size: 0.95rem;
      color: var(--text-secondary);
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    /* Logos / instructor block */
    .instructor-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px 32px;
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .instructor-info {
      flex: 1;
      min-width: 0;
    }
    .instructor-logo {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 14px 18px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      min-width: 132px;
      height: 64px;
    }
    .instructor-logo img {
      max-height: 36px;
      max-width: 100%;
      width: auto;
      object-fit: contain;
      display: block;
    }
    @media (max-width: 768px) {
      .instructor-card { flex-wrap: wrap; }
      .instructor-logo { min-width: 100%; }
      /* 슬라이드 11 헤드라인: 모바일에서는 nowrap 해제하여 줄바꿈 허용 */
      .section-headline { white-space: normal !important; font-size: 1.75rem !important; }
      .section-headline span { display: inline-block; margin-bottom: 4px; }
    }
    .instructor-avatar {
      width: 72px; height: 72px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      flex-shrink: 0;
    }
    .instructor-name {
      font-size: 1.375rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 4px;
    }
    .instructor-role {
      font-size: 0.9rem;
      color: var(--text-secondary);
    }
    .instructor-area {
      font-size: 0.95rem;
      color: var(--text);
      margin-top: 8px;
      font-weight: 500;
    }

    /* Final CTA slide */
    .final-slide {
      text-align: center;
      align-items: center;
    }
    .final-mark {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: -0.02em;
      text-transform: none;
      margin-bottom: 32px;
    }
    @media (max-width: 768px) {
      .final-mark { font-size: 1.125rem; margin-bottom: 24px; }
    }
    .final-title {
      font-size: clamp(2.5rem, 6vw, 7.5rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.1;
